# Copy to .env and adjust. Any value in forge.toml can be overridden with FORGE_<UPPERCASE_NAME>.
FORGE_LLM=openai              # set to "mock" for fully offline deterministic runs
FORGE_BASE_URL=http://localhost:11434/v1
FORGE_API_KEY=ollama
FORGE_AGENT_MODEL=qwen2.5:7b-instruct
FORGE_FACTORY_MODEL=qwen2.5:7b-instruct
FORGE_JUDGE_MODEL=llama3.1:8b
